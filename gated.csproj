<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.32.10</Version>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>gated.ico</ApplicationIcon>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(DisableUpdater)' == 'true' Or '$(DisableUpdater)' == 'True' Or '$(DisableUpdater)' == '1'">
        <DefineConstants>DISABLE_UPDATER;$(DefineConstants)</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSIX)' == 'true' Or '$(MSIX)' == 'True' Or '$(MSIX)' == '1'">
        <DefineConstants>MSIX;$(DefineConstants)</DefineConstants>
    </PropertyGroup>
    <Target Name="ShowDisableUpdaterFlag" BeforeTargets="CoreCompile" Condition="'$(DisableUpdater)' == 'true' Or '$(DisableUpdater)' == 'True' Or '$(DisableUpdater)' == '1'">
        <Message Importance="High" Text="DISABLE_UPDATER is enabled for $(MSBuildProjectName)." />
    </Target>
    <ItemGroup>
      <AvaloniaXaml Remove=".github\**" />
      <AvaloniaXaml Remove="artifacts\**" />
      <AvaloniaXaml Remove="Msix\**" />
      <AvaloniaXaml Remove="Pixels\**" />
      <AvaloniaXaml Remove="Updater\**" />
      <Compile Remove=".github\**" />
      <Compile Remove="artifacts\**" />
      <Compile Remove="Msix\**" />
      <Compile Remove="Pixels\**" />
      <Compile Remove="Updater\**" />
      <Compile Remove="Tests\**" />
      <EmbeddedResource Remove=".github\**" />
      <EmbeddedResource Remove="artifacts\**" />
      <EmbeddedResource Remove="Msix\**" />
      <EmbeddedResource Remove="Pixels\**" />
      <EmbeddedResource Remove="Updater\**" />
      <None Remove=".github\**" />
      <None Remove="artifacts\**" />
      <None Remove="Msix\**" />
      <None Remove="Pixels\**" />
      <None Remove="Updater\**" />
      <None Remove="Tests\**" />

      <AvaloniaXaml Remove="Installer\**" />
      <Compile Remove="Installer\**" />
      <EmbeddedResource Remove="Installer\**" />
      <None Remove="Installer\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <PackageReference Include="pythonnet" Version="3.1.0" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.3" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Fonts\*.ttf" />
      <AvaloniaResource Include="Fonts\*.ttf" />

      <None Remove="Resources\**\*.svg" />
      <AvaloniaResource Include="Resources\**\*.svg" />
        
      <None Remove="Python\*.py" />
      <AvaloniaResource Include="Python\*.py" />
      <None Remove="gated-32.png" />
      <None Remove="gated.ico" />
      <AvaloniaResource Include="gated-32.png" />
      <AvaloniaResource Include="gated.ico" />
    </ItemGroup>

    <ItemGroup Condition="'$(MSIX)' == 'true' Or '$(MSIX)' == 'True' Or '$(MSIX)' == '1'">
      <None Update="python-313.zip">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
